# Only startup settings. Telegram and LLM credentials belong in the panel.
# Dummy value only: replace this placeholder before starting.
PANEL_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD_AT_LEAST_32_CHARACTERS
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
# For local use; for HTTPS set the exact externally accessible panel URL.
PANEL_URL=http://127.0.0.1:8080
# Relative paths resolve beside config.py, not against the shell working dir.
DB_PATH=data/newsbot.db
TZ_NAME=Europe/Moscow
